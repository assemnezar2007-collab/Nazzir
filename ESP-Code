//                 HTTP HANDLERS
// ==================================================

void handleData() {

  server.send(
    200,
    "application/json",
    latestSensorJson
  );

}

void handleRoot() {

  server.send_P(
    200,
    "text/html",
    PAGE
  );

}

// ==================================================
//                 MQTT CONNECTION
// ==================================================

void reconnectMQTT() {

  if (mqttClient.connected()) return;

  Serial.print("Connecting to HiveMQ...");

  String clientId =
    "NASA-Rover-" +
    String((uint32_t)ESP.getEfuseMac(), HEX);

  if (mqttClient.connect(clientId.c_str())) {

    Serial.println("MQTT Connected!");

    if (mqttClient.subscribe(mqttCommandTopic)) {

      Serial.println("Subscribed to Mission Command Topic!");

      if (missionAbortedByMqtt) {

        publishMissionStatus(
          "MISSION_ABORTED_MQTT_LOST"
        );

        missionAbortedByMqtt = false;

      }

    } else {

      Serial.println("Command Subscription Failed!");

    }

  } else {

    Serial.print("MQTT Connection Failed. State: ");

    Serial.println(mqttClient.state());

  }

}

// ==================================================
//                 PUBLISH SENSOR DATA
// ==================================================

void publishSensorData() {

  if (!mqttClient.connected()) return;

  bool published =
    mqttClient.publish(
      mqttTopic,
      latestSensorJson.c_str()
    );

  if (published) {

    Serial.println("MQTT Data Published:");

    Serial.println(latestSensorJson);

  } else {

    Serial.println("MQTT Publish Failed!");

  }

}

// ==================================================
//                      SETUP
// ==================================================

void setup() {

  Serial.begin(115200);

  pinMode(ENA_PIN, OUTPUT);
  pinMode(IN1_PIN, OUTPUT);
  pinMode(IN2_PIN, OUTPUT);

  pinMode(IN3_PIN, OUTPUT);
  pinMode(IN4_PIN, OUTPUT);
  pinMode(ENB_PIN, OUTPUT);

  stopMotors();

  // SENSORS
  dht.begin();

  Wire.begin(21, 22);

  if (mpu.begin()) {

    mpuReady = true;

    Serial.println("MPU6050 Connected!");

  } else {

    Serial.println("MPU6050 Not Found!");

  }

  if (bmp.begin()) {

    bmpReady = true;

    Serial.println("BMP180 Connected!");

  } else {

    Serial.println("BMP180 Not Found!");

  }

  // WIFI
  WiFi.mode(WIFI_AP_STA);

  mqttClient.setServer(mqttServer, mqttPort);

  mqttClient.setCallback(mqttCallback);

  mqttClient.setBufferSize(512);

  if (WiFi.softAP(apSSID, apPassword)) {

    Serial.println("Access Point Started!");

    Serial.print("Dashboard IP: ");

    Serial.println(WiFi.softAPIP());

  } else {

    Serial.println("Access Point Failed!");

  }

  WiFi.begin(wifiSSID, wifiPassword);

  Serial.print("Connecting to Internet");

  int attempts = 0;

  while (
    WiFi.status() != WL_CONNECTED &&
    attempts < 40
  ) {

    delay(500);

    Serial.print(".");

    attempts++;

  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("\nInternet WiFi Connected!");

    Serial.print("Internet IP: ");

    Serial.println(WiFi.localIP());

  } else {

    Serial.println("\nInternet WiFi Connection Failed!");

  }

  // WEB SERVER
  server.on("/", HTTP_GET, handleRoot);

  server.on("/data", HTTP_GET, handleData);

  server.begin();

  updateSensorData();

  lastSensorRead = millis();

  Serial.println("NASA Rover Dashboard Ready!");

}

// ==================================================
//                       LOOP
// ==================================================

void loop() {

  server.handleClient();

  // MQTT LOSS SAFETY
  if (missionRunning && !mqttClient.connected()) {

    stopMotors();

    missionRunning = false;

    missionPhase = MISSION_IDLE;

    phaseStartTime = 0;

    missionAbortedByMqtt = true;

    Serial.println("!!! MQTT LOST - MOTORS STOPPED !!!");

  }

  // MQTT RECONNECT
  if (
    WiFi.status() == WL_CONNECTED &&
    !mqttClient.connected() &&
    millis() - lastReconnectAttempt >= reconnectInterval
  ) {

    lastReconnectAttempt = millis();

    reconnectMQTT();

  }

  if (mqttClient.connected()) {

    mqttClient.loop();

  }

  // MISSION UPDATE
  updateRoverMission();

  // SENSOR UPDATE
  if (millis() - lastSensorRead >= sensorInterval) {

    lastSensorRead = millis();

    updateSensorData();

    if (mqttClient.connected()) {

      publishSensorData();

    }

  }

}
