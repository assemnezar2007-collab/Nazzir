// ==================================================
//                 MOTOR CONTROL
// ==================================================

void stopMotors() {

  digitalWrite(IN1_PIN, LOW);
  digitalWrite(IN2_PIN, LOW);

  digitalWrite(IN3_PIN, LOW);
  digitalWrite(IN4_PIN, LOW);

  analogWrite(ENA_PIN, 0);
  analogWrite(ENB_PIN, 0);

}

// ==================================================
//                 MOVE FORWARD
// ==================================================

void moveForward(int speedL, int speedR) {

  digitalWrite(IN1_PIN, HIGH);
  digitalWrite(IN2_PIN, LOW);

  // Right motor direction corrected
  digitalWrite(IN3_PIN, LOW);
  digitalWrite(IN4_PIN, HIGH);

  analogWrite(ENA_PIN, speedL);
  analogWrite(ENB_PIN, speedR);

}

// ==================================================
//                 TURN RIGHT
// ==================================================

void turnRight() {

  // Left motor forward
  digitalWrite(IN1_PIN, HIGH);
  digitalWrite(IN2_PIN, LOW);

  // Right motor backward
  digitalWrite(IN3_PIN, HIGH);
  digitalWrite(IN4_PIN, LOW);

  analogWrite(ENA_PIN, TURN_SPEED);
  analogWrite(ENB_PIN, TURN_SPEED);

}

// ==================================================
//                 MQTT STATUS
// ==================================================

void publishMissionStatus(const char* status) {

  if (mqttClient.connected()) {

    bool sent = mqttClient.publish(mqttStatusTopic, status);

    Serial.print("Mission Status: ");

    Serial.println(sent ? status : "Publish Failed");

  }

}

// ==================================================
//                 STOP MISSION
// ==================================================

void stopRoverMission(bool notifyDashboard) {

  stopMotors();

  missionRunning = false;
  missionPhase = MISSION_IDLE;

  phaseStartTime = 0;
  completedSides = 0;

  Serial.println(">>> MISSION STOPPED <<<");

  if (notifyDashboard) {
    publishMissionStatus("MISSION_STOPPED");
  }

}

// ==================================================
//                 START MISSION
// ==================================================

void startRoverMission() {

  if (missionRunning) return;

  missionAbortedByMqtt = false;

  missionRunning = true;

  completedSides = 0;

  missionPhase = MISSION_FORWARD;

  phaseStartTime = millis();

  moveForward(
    MOTOR_SPEED_LEFT,
    MOTOR_SPEED_RIGHT
  );

  Serial.println(">>> SQUARE MISSION STARTED <<<");
  Serial.println("Side 1 - Moving 2 Meters");

  publishMissionStatus("MISSION_STARTED");

}

// ==================================================
//                 MQTT CALLBACK
// ==================================================

void mqttCallback(
  char* topic,
  byte* payload,
  unsigned int length
) {

  String receivedMessage;

  receivedMessage.reserve(length);

  for (unsigned int i = 0; i < length; i++) {
    receivedMessage += (char)payload[i];
  }

  receivedMessage.trim();

  Serial.print("MQTT Topic: ");
  Serial.println(topic);

  Serial.print("MQTT Message: ");
  Serial.println(receivedMessage);

  if (String(topic) != mqttCommandTopic) return;

  if (receivedMessage == "START_MISSION") {

    startRoverMission();

  }

  else if (receivedMessage == "STOP_MISSION") {

    if (missionRunning) {
      stopRoverMission(true);
    } else {
      stopMotors();
      publishMissionStatus("MISSION_STOPPED");
    }

  }

}

// ==================================================
//             AUTOMATIC SQUARE MISSION
// ==================================================

void updateRoverMission() {

  if (!missionRunning) return;

  unsigned long now = millis();

  switch (missionPhase) {

    // MOVE FORWARD 2 METERS
    case MISSION_FORWARD:

      if (now - phaseStartTime >= TIME_2M) {

        stopMotors();

        phaseStartTime = now;

        missionPhase = MISSION_STOP_BEFORE_TURN;

        completedSides++;

        Serial.print("Side Completed: ");
        Serial.println(completedSides);

      }

      break;

    // STOP BEFORE TURN
    case MISSION_STOP_BEFORE_TURN:

      if (now - phaseStartTime >= STOP_DELAY) {

        // FINISH AFTER FOURTH SIDE
        if (completedSides >= 4) {

          stopMotors();

          missionRunning = false;

          missionPhase = MISSION_FINISHED;

          Serial.println(">>> SQUARE MISSION COMPLETED <<<");

          publishMissionStatus("MISSION_COMPLETED");

        }

        else {

          turnRight();

          phaseStartTime = now;

          missionPhase = MISSION_TURN_RIGHT;

          Serial.println("Turning Right 90 Degrees");

        }

      }

      break;

    // TURN RIGHT
    case MISSION_TURN_RIGHT:

      if (now - phaseStartTime >= TIME_TURN_RIGHT) {

        stopMotors();

        phaseStartTime = now;

        missionPhase = MISSION_STOP_AFTER_TURN;

        Serial.println("Right Turn Completed");

      }

      break;

    // STOP AFTER TURN
    case MISSION_STOP_AFTER_TURN:

      if (now - phaseStartTime >= STOP_DELAY) {

        moveForward(
          MOTOR_SPEED_LEFT,
          MOTOR_SPEED_RIGHT
        );

        phaseStartTime = now;

        missionPhase = MISSION_FORWARD;

        Serial.print("Starting Side: ");
        Serial.println(completedSides + 1);

      }

      break;

    case MISSION_IDLE:
    case MISSION_FINISHED:
      break;

  }

}

// ==================================================
//                 SENSOR DATA
// ==================================================

void updateSensorData() {

  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  bool dhtDataReady =
    !isnan(temperature) && !isnan(humidity);

  float ax = 0, ay = 0, az = 0;
  float gx = 0, gy = 0, gz = 0;
  float slope = 0;

  if (mpuReady) {

    sensors_event_t a, g, t;

    mpu.getEvent(&a, &g, &t);

    ax = a.acceleration.x;
    ay = a.acceleration.y;
    az = a.acceleration.z;

    gx = g.gyro.x;
    gy = g.gyro.y;
    gz = g.gyro.z;

    slope =
      atan2(
        sqrt(ax * ax + ay * ay),
        fabs(az)
      ) * 180.0 / PI;

  }

  float pressure = 0;
  float altitude = 0;
  float bmpTemp = 0;

  if (bmpReady) {

    pressure = bmp.readPressure() / 100.0;

    altitude = bmp.readAltitude(101325);

    bmpTemp = bmp.readTemperature();

  }

  String json = "{";

  json += "\"temperature\":" +
    (dhtDataReady ? String(temperature, 2) : "null");

  json += ",\"humidity\":" +
    (dhtDataReady ? String(humidity, 2) : "null");

  json += ",\"dhtReady\":" +
    String(dhtDataReady ? "true" : "false");

  json += ",\"mpuReady\":" +
    String(mpuReady ? "true" : "false");

  json += ",\"bmpReady\":" +
    String(bmpReady ? "true" : "false");

  json += ",\"pressure\":" +
    (bmpReady ? String(pressure, 2) : "null");

  json += ",\"altitude\":" +
    (bmpReady ? String(altitude, 2) : "null");

  json += ",\"bmpTemp\":" +
    (bmpReady ? String(bmpTemp, 2) : "null");

  json += ",\"ax\":" +
    (mpuReady ? String(ax, 2) : "null");

  json += ",\"ay\":" +
    (mpuReady ? String(ay, 2) : "null");

  json += ",\"az\":" +
    (mpuReady ? String(az, 2) : "null");

  json += ",\"gx\":" +
    (mpuReady ? String(gx, 2) : "null");

  json += ",\"gy\":" +
    (mpuReady ? String(gy, 2) : "null");

  json += ",\"gz\":" +
    (mpuReady ? String(gz, 2) : "null");

  json += ",\"slope\":" +
    (mpuReady ? String(slope, 2) : "null");

  json += "}";

  latestSensorJson = json;

}

